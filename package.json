{
  "name": "35mm-world",
  "description": "Film photography showcase.",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielfdsilva/35mm-world.git"
  },
  "author": {
    "name": "Daniel da Silva",
    "url": "http://danielfdsilva.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/developmentseed/project-seed/issues"
  },
  "homepage": "https://35.danielfdsilva.com",
  "scripts": {
    "prepare": "husky",
    "dev": "npm run clean && NODE_ENV=development vite",
    "build": "npm run clean && NODE_ENV=production tsc -b && vite build",
    "stage": "npm run clean && NODE_ENV=staging tsc -b && vite build",
    "clean": "rm -rf dist node_modules/.vite",
    "lint": "npm run lint:scripts",
    "lint:scripts": "eslint app/",
    "ts-check": "npx tsc --noEmit --skipLibCheck",
    "test": "jest",
    "images:camera": "scripts/optimize-images.sh --trim .resources/alpha app/media/camera",
    "images:photos": "scripts/process-photos.sh"
  },
  "engines": {
    "node": "24.x"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "motion": "^12.43.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "alias": {
    "$components": "~/app/components",
    "$styles": "~/app/styles",
    "$utils": "~/app/utils",
    "$hooks": "~/app/hooks",
    "$pages": "~/app/pages",
    "$test": "~/test"
  }
}
